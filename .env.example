# Postgres connection string. Default matches a local Postgres started by Docker:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=postgresql://postgres:124578@localhost:5432/midroc
# postgresql://postgres:124578@localhost:5432
# postgres://postgres:postgres@localhost:5432
# Admin password used by `npm run db:seed`. After seeding, the hash lives in the
# `admin` table — change it by re-running the seed.
ADMIN_PASSWORD=midroc2026

# HS256 secret used to sign JWTs for /api/auth/login. Replace with a random string.
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express server listens on. Vite proxies /api -> this port in dev.
PORT=3001